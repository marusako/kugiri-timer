{
  "name": "pomodoro-timer",
  "version": "1.0.0",
  "description": "Electron で作るポモドーロタイマー",
  "type": "module",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test \"test/**/*.test.js\"",
    "dist": "electron-builder --win"
  },
  "build": {
    "appId": "com.example.pomodoro-timer",
    "productName": "Pomodoro Timer",
    "files": [
      "main.js",
      "src/**/*"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false
    },
    "portable": {
      "artifactName": "${productName} ${version} Portable.${ext}"
    }
  },
  "devDependencies": {
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3"
  }
}
