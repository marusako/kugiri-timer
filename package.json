{
  "name": "pomodoro-timer",
  "version": "1.6.2",
  "description": "Electron で作るポモドーロタイマー",
  "license": "MIT",
  "type": "module",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test \"test/**/*.test.js\"",
    "dist": "electron-builder --win --publish never"
  },
  "build": {
    "appId": "io.github.marusako.pomodoro-timer",
    "productName": "Pomodoro Timer",
    "directories": {
      "output": "dist/${version}"
    },
    "files": [
      "main.js",
      "media-store.js",
      "preload.cjs",
      "src/**/*"
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "${name}-Setup-${version}.${ext}"
    },
    "publish": {
      "provider": "github",
      "owner": "marusako",
      "repo": "pomodoro-timer",
      "releaseType": "release"
    }
  },
  "devDependencies": {
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
